+    @_require_auth
+    async def _handle_session_yolo(self, request: web.Request) -> web.Response:
+        """GET/POST /v1/session/yolo — 查询/切换某会话的 YOLO（跳过危险命令审批）。
+
+        APP（小Q）左下角「Y」气泡调这里。审批层把 YOLO 挂在 ``set_current_session_key``
+        的 key 上，而 chat 侧该 key 是每次请求的 approval_session_key（= completion_id），
+        所以本端点只存「会话级意图」（key = X-Hermes-Session-Id），真正生效靠
+        ``_run_agent`` 里的继承：本会话开了 YOLO，就把当次 run 的 approval key 也打开。
+
+        GET  → {"session_key": "...", "yolo": bool}
+        POST body {"enabled": true|false}；不带 enabled 则取反。
+
+        状态是**进程内内存**（与 /yolo 命令一致），Gateway 重启即清。
+        """
+        from tools.approval import (
+            disable_session_yolo,
+            enable_session_yolo,
+            is_session_yolo_enabled,
+        )
+
+        gateway_session_key, key_err = self._parse_session_key_header(request)
+        if key_err is not None:
+            return key_err
+        session_key = (
+            gateway_session_key
+            or request.headers.get("X-Hermes-Session-Id", "").strip()
+        )
+        if not session_key:
+            return web.json_response(
+                {"error": "missing session key: send X-Hermes-Session-Id header"},
+                status=400,
+            )
+
+        if request.method == "GET":
+            return web.json_response({
+                "session_key": session_key,
+                "yolo": is_session_yolo_enabled(session_key),
+            })
+
+        try:
+            body = await request.json()
+        except Exception:
+            body = {}
+        if isinstance(body, dict) and "enabled" in body:
+            enabled = bool(body.get("enabled"))
+        else:
+            enabled = not is_session_yolo_enabled(session_key)
+
+        (enable_session_yolo if enabled else disable_session_yolo)(session_key)
+        logger.info(
+            "session yolo %s: %s",
+            "enabled" if enabled else "disabled",
+            session_key[:24],
+        )
+        return web.json_response({"session_key": session_key, "yolo": enabled})
+
